{
    "headers":  [
                    {
                        "headers":  [
                                        {
                                            "key":  "Content-Security-Policy",
                                            "value":  "default-src \u0027none\u0027; script-src \u0027self\u0027; style-src \u0027self\u0027; font-src \u0027self\u0027; img-src \u0027self\u0027; connect-src \u0027self\u0027; object-src \u0027none\u0027; frame-src \u0027none\u0027; base-uri \u0027none\u0027; form-action \u0027none\u0027; upgrade-insecure-requests"
                                        },
                                        {
                                            "key":  "X-Content-Type-Options",
                                            "value":  "nosniff"
                                        },
                                        {
                                            "key":  "X-Frame-Options",
                                            "value":  "DENY"
                                        },
                                        {
                                            "key":  "Referrer-Policy",
                                            "value":  "no-referrer"
                                        },
                                        {
                                            "key":  "Strict-Transport-Security",
                                            "value":  "max-age=31536000"
                                        },
                                        {
                                            "key":  "Permissions-Policy",
                                            "value":  "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
                                        }
                                    ],
                        "source":  "/(.*)"
                    }
                ],
    "cleanUrls":  true,
    "version":  2
}
